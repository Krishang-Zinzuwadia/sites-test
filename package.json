{
  "name": "assembled-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:cloudflare": "tsc -b && vite build --config vite.cloudflare.config.ts",
    "deploy": "npm run build:cloudflare && cf deploy --prebuilt --mode production",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "gsap": "^3.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "cf": "^1.0.0-beta.27",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
